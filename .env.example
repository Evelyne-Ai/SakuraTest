# ---- Backend (backend/src/config/env.js membaca file .env di folder tempat backend dijalankan) ----
NODE_ENV=development
PORT=4000
# Daftar origin yang boleh memanggil API, dipisah koma
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
REQUEST_TIMEOUT_MS=10000
# Slug tool yang ingin dipaksa status maintenance, dipisah koma. Contoh: hash,uuid
MAINTENANCE_TOOLS=

# ---- Integrasi eksternal (opsional; kosong = tool terkait berstatus "not configured") ----
# Catatan: runner untuk tool ini BELUM ditulis. Mengisi variabel saja tidak cukup,
# lihat README bagian "Integrasi yang butuh konfigurasi".
DOWNLOADER_PROVIDER_URL=
AI_PROVIDER_API_KEY=

# ---- Frontend (prefix VITE_; dibaca saat build/dev; jangan taruh secret di sini) ----
# VITE_API_URL=/api
# VITE_PUBLIC_API_ORIGIN=https://api.contoh.com
# VITE_CONTACT_EMAIL=
# VITE_SOCIAL_LINKS=[{"label":"GitHub","url":"https://github.com/akun-anda"}]

# ---- SakuraApis: akun, API key, paket ----
# Folder penyimpanan data (db.json: user, hash API key, log). Default: backend/data. Isi "memory" untuk tidak menulis file.
DATA_DIR=
# Email yang otomatis jadi admin saat register (dipisah koma). Admin bisa mengaktifkan paket user.
ADMIN_EMAILS=
# Limit request harian paket Free (per akun, reset 00:00 UTC)
FREE_DAILY_LIMIT=100
# Link kontak pembelian paket (mis. https://wa.me/62xxxxxxxxxx). Kosong = tombol beli tidak tampil.
BUY_CONTACT_URL=
