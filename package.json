{
  "name": "sakuraapis",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "test": "npm run test -w backend",
    "typecheck": "npm run typecheck -w frontend"
  },
  "devDependencies": { "concurrently": "^9.0.1" },
  "engines": { "node": ">=20" }
}
